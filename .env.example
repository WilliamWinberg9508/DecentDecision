# Copy to .env and fill in. Generate each secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

POSTGRES_PASSWORD=

# Bootstrap credential for the /admin/... API. Rotate it from the admin page
# once the site is up: after the first rotation this value stops working and
# only a hash of the live token is stored in the database.
ADMIN_TOKEN=

# --- required before going public -------------------------------------------

# false on http://localhost, true once Cloudflare is serving HTTPS. When false
# the session cookie has no Secure flag, so a browser will send it over plain
# http -- which is the whole session, in the clear.
COOKIE_SECURE=false

# Used to build email verification links. Must match the public address.
SITE_URL=http://localhost:8100

# --- optional: email verification --------------------------------------------
# Leave SMTP_HOST blank and verification still works -- the admin page shows
# the link to pass on by hand. Fill it in and the link is emailed instead.

SMTP_HOST=
SMTP_PORT=25
SMTP_FROM=noreply@decentdecision.com
SMTP_USER=
SMTP_PASSWORD=

# Shown in the footer of every page. Under BBS-lagen you are expected to act on
# notice, and people can only give notice if there is somewhere to send it.
ABUSE_CONTACT=

# --- who gets an agent --------------------------------------------------------

# true  : confirming the email address approves the account and creates its
#         agent slot, with no admin in the loop. Scales; relies on email being
#         a proxy for personhood, which it only partly is.
# false : verification still happens, but an admin approves. Stricter. Switch
#         back to this if you start seeing accounts rather than people.
AUTO_APPROVE_VERIFIED=true

# New accounts per source address per hour. Matters much more with auto-approve
# on, because registration is then directly a route to a vote.
SIGNUPS_PER_HOUR=5

# Extra email domains to refuse, comma separated. A list of the common
# disposable providers is built in.
BLOCKED_EMAIL_DOMAINS=

# --- login rate limiting -----------------------------------------------------

# Failed sign-ins per source address per 15 minutes, a hard cap. This is CPU
# protection: scrypt is deliberately expensive, so an unthrottled login form is
# also a cheap way to spend every core the site has.
LOGIN_FAILS_PER_IP=20

# Failed sign-ins per account per 15 minutes before each further attempt has to
# wait, doubling up to a minute. A pause, not a lock -- a lock would let anyone
# who knows your username keep you out of your own site.
LOGIN_FAILS_PER_ACCOUNT=8

# How long a password reset link stays valid, in minutes.
RESET_TTL_MINUTES=60

# --- backups -----------------------------------------------------------------
# pgBackRest: weekly full, daily incremental, continuous WAL archiving. Times
# are in the container's clock, which is UTC.

# 0 = Sunday. The other six days take an incremental.
BACKUP_FULL_DOW=0

# Hour of day to run it. 3 is 05:00 in Swedish summer time, 04:00 in winter.
BACKUP_HOUR=3

# Off-machine copy. Only needed if you uncomment the repo2 block in
# backup/pgbackrest.conf -- until then the backups are on the same disk as the
# database, which protects you from mistakes but not from the machine.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
