# The same file as .env.example, with every blank filled in, so the shape of a
# real one is visible at a glance. Everything here is invented -- the secrets
# are the right length and format but are not valid, and the R2 keys point at
# nothing. Copy .env.example to .env and generate your own.
#
# This file is for reading, not for using.
#
#   python -c "import secrets; print(secrets.token_urlsafe(32))"


# =============================================================================
# The database
# =============================================================================

# Only ever seen by the api and postgres containers, over the compose network.
POSTGRES_PASSWORD=Kj8vQm2xRt5wYn9pLc3hFd6sAe4zBu7N

# The bootstrap credential for the /admin/... API. Works until you rotate it
# from the admin page; after the first rotation this value is inert and only a
# hash of the live token is in the database.
ADMIN_TOKEN=xPq4Nw8LmC2vKd9RtY6bHj3sZg7FaE5u


# =============================================================================
# How the site is reached
# =============================================================================

# true once Cloudflare is serving this over HTTPS. Leave it false while you are
# on http://localhost, or the session cookie is never sent and every login
# appears to succeed and then does nothing.
COOKIE_SECURE=true

# Must match the public address exactly: it is what verification and password
# reset links are built from.
SITE_URL=https://decentdecision.com

# In the footer of every page. Under BBS-lagen you are expected to act on
# notice, and people can only give notice if there is somewhere to send it.
# A real mailbox you actually read.
ABUSE_CONTACT=abuse@decentdecision.com


# =============================================================================
# Mail
# =============================================================================
# Leave SMTP_HOST blank and everything still works: verification links appear
# on the admin page to pass on by hand, and reset links go to the container log.
# Filled in, they are emailed instead.
#
# These are for a transactional provider rather than a personal mailbox. Gmail
# will not send for you from a server, and a self-hosted relay on a home
# address gets filed as spam by everyone.

SMTP_HOST=smtp.postmarkapp.com
SMTP_PORT=587
SMTP_FROM=noreply@decentdecision.com
SMTP_USER=e4f1c9a7-3b2d-4c81-9f6a-2d7e8b1c5a03
SMTP_PASSWORD=e4f1c9a7-3b2d-4c81-9f6a-2d7e8b1c5a03


# =============================================================================
# Who gets an agent
# =============================================================================

# true  : confirming the email address approves the account and creates its
#         agent slot, with no admin in the loop.
# false : verification still happens, but an admin approves. Go back to this if
#         you start seeing accounts rather than people.
AUTO_APPROVE_VERIFIED=true

# New accounts per source address per hour.
SIGNUPS_PER_HOUR=5

# Extra email domains to refuse, comma separated. A list of the common
# disposable providers is built in; these are ones that got past it.
BLOCKED_EMAIL_DOMAINS=mailbox.org.uk,tempr.email,inboxbear.com


# =============================================================================
# Login rate limiting
# =============================================================================

# Failed sign-ins per source address per 15 minutes, a hard cap. 20 is roomy
# for a household behind one address and still cheap to serve.
LOGIN_FAILS_PER_IP=20

# Failed sign-ins per account per 15 minutes before each further attempt has to
# wait, doubling up to a minute. A pause, not a lock.
LOGIN_FAILS_PER_ACCOUNT=8

# How long a reset link stays valid, in minutes. An hour is long enough for a
# slow mail relay and short enough that an old link in a mailbox is not a key.
RESET_TTL_MINUTES=60


# =============================================================================
# Backups
# =============================================================================
# pgBackRest: continuous WAL archiving, a weekly full and a daily incremental.
# Times are the container's clock, which is UTC.

# 0 = Sunday, so Sunday is the full and Monday to Saturday are incrementals.
BACKUP_FULL_DOW=0

# 03:00 UTC = 05:00 Swedish summer time, 04:00 in winter. Pick an hour when the
# machine is on and you are not using it.
BACKUP_HOUR=3

# The off-machine copy, used only when the repo2 block in
# backup/pgbackrest.conf is uncommented. These are Cloudflare R2 API tokens
# scoped to one bucket -- not your Cloudflare account key, and not the same
# token the tunnel uses.
#
# Until this is switched on, the backups live on the same disk as the database.
# That covers a bad migration, a dropped table and the purge button. It does
# not cover the disk, the machine, or the room the machine is in.
R2_ACCESS_KEY_ID=4c1f8e2a9b7d6503e8a1c4f7b2d95e60
R2_SECRET_ACCESS_KEY=9f3b7d21c8a54e607b2f9d4a1c6e8350b7d2f9a4c1e6803b5d7f2a9c4e1b6083
